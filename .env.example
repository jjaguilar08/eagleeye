# Copy this file to .env and adjust as needed. Never commit the real .env.
# Everything here uses local-dev-only defaults — no real secrets, ever.

# --- Postgres (used by docker-compose and apps/api/prisma) ---
POSTGRES_USER=eagleeye
POSTGRES_PASSWORD=eagleeye_dev_password
POSTGRES_DB=eagleeye
DATABASE_URL="postgresql://eagleeye:eagleeye_dev_password@localhost:5432/eagleeye?schema=public"

# --- Redis (used by docker-compose; consumed by apps/api starting Day 2+) ---
REDIS_URL="redis://localhost:6379"

# --- apps/api (optional, both have sane defaults) ---
PORT=4000
HOST=0.0.0.0

# CORS: the Next.js dev origin allowed to call apps/api (optional, sane default below)
WEB_ORIGIN=http://localhost:3000

# --- NewsAPI.org (apps/api, used by SearchService) ---
# Free "Developer" plan: https://newsapi.org/register — $0, hard-capped at
# 100 requests/day with no overage/billing mechanism on that tier, restricted
# to development/testing use (fine here — this app is never deployed live).
# Fill in your real key in your local .env only — never commit it.
NEWSAPI_KEY=your-newsapi-org-key

# --- Anthropic API (apps/api, used by Day 8's AI email-drafting service) ---
# Real per-call cost — this step lives behind the automation gate. Fill in
# your real key in your local .env only — never commit it.
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Resend (apps/api, used by Day 9's email-send service) ---
# Free tier: 3,000 emails/month, 100/day, one verified domain — genuinely
# free, unlike Postmark/SendGrid's current trial-only "free" tiers (see
# notes.md Day 9). Sending is hard-locked to WhitelistEntry regardless of
# what's configured here. Fill in your real values in your local .env only —
# never commit them.
#
# No verified domain yet? Resend sandboxes unverified accounts: you can only
# send FROM onboarding@resend.dev, and only TO the email address you signed
# up to Resend with. Set RESEND_FROM_EMAIL=onboarding@resend.dev and
# whitelist your own Resend signup address to test sends in that mode.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=alex@yourdomain.com

# --- Resend inbound webhook (apps/api, used by Day 10's reply-ingestion route) ---
# Signing secret Resend gives you when you create the webhook (Webhooks tab,
# subscribed to email.received) — verifies POST /webhooks/resend-inbound
# actually came from Resend, via svix signature verification. Fill in your
# real value in your local .env only — never commit it.
RESEND_WEBHOOK_SECRET=

# --- apps/web (public: inlined into the client bundle, not secret) ---
# Must match apps/api's PORT above.
NEXT_PUBLIC_API_URL=http://localhost:4000
