{
  "name": "@eagleeye/api",
  "version": "0.1.0",
  "private": true,
  "description": "EagleEye backend API (Fastify).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
