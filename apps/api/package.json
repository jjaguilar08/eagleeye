{
  "name": "@eagleeye/api",
  "version": "0.1.0",
  "private": true,
  "description": "EagleEye backend API (Fastify).",
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "prisma generate && vitest run"
  },
  "dependencies": {
    "@eagleeye/types": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@prisma/client": "^6.3.1",
    "cheerio": "^1.2.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.2.1",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "domhandler": "^5.0.3",
    "playwright": "^1.62.1",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
