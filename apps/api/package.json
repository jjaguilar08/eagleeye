    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "dotenv": "^16.6.1",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
